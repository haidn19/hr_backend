# Do not commit a real .env file. Copy this file to .env or configure the
# same values in the environment where the backend runs.
#
# Required backend secrets. Generate JWT_SECRET with a cryptographically secure
# random value, for example: openssl rand -base64 48
DB_URL=jdbc:mysql://db.example.com:3306/demo_db?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=replace-with-database-username
DB_PASSWORD=replace-with-database-password
JWT_SECRET=replace-with-a-base64-encoded-random-secret
JWT_EXPIRATION=3600000

# Used only by docker-compose.yml when starting the local MySQL container.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-local-password
MYSQL_DATABASE=hrm_db
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306

# Keep this restricted to the frontend domain(s) for the current environment.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000

# These are credentials for the service that SENDS email. Mail.tm does not
# provide SMTP sending credentials; it is used as the destination inbox below.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password-or-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=hr@example.com

# Create an inbox at https://mail.tm, then paste its complete address here to
# have all test emails delivered there. Leave empty to send to each employee's
# email stored in the database.
MAIL_RECIPIENT_OVERRIDE=your-inbox@mail.tm

# Runtime and logging configuration. Do not log credentials, tokens, or request
# bodies. In production, use JPA_DDL_AUTO=validate and JPA_SHOW_SQL=false.
APP_NAME=hr-backend
SERVER_PORT=8080
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
APP_HOLIDAYS=
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=INFO
LOGGING_LEVEL_SPRING_WEB=WARN
LOGGING_LEVEL_HIBERNATE=WARN
LOGGING_FILE_NAME=logs/application.log
LOGGING_MAX_FILE_SIZE=20MB
LOG_CLEANUP_DIRECTORY=logs
LOG_CLEANUP_CRON=0 0 1 * * *
LOG_CLEANUP_ZONE=Asia/Ho_Chi_Minh
LOG_CLEANUP_RETENTION_DAYS=2
MONTHLY_TASK_CRON=0 0 10 5 * *
MONTHLY_TASK_ZONE=Asia/Ho_Chi_Minh
MAIL_DEFAULT_ENCODING=UTF-8
MAIL_CONNECTION_TIMEOUT=5000
MAIL_TIMEOUT=5000
MAIL_WRITE_TIMEOUT=5000

# Used by the full-stack Docker Compose configuration.
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
BACKEND_IMAGE=your-dockerhub-user/hrm-backend:v1
FRONTEND_IMAGE=your-dockerhub-user/hrm-frontend:v1
